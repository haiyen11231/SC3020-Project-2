# Copy this file to .env and fill in your values (.env is not committed to git).
PGHOST=localhost
PGPORT=5432
PGDATABASE=tpch
PGUSER=postgres
PGPASSWORD=your-postgres-password
GEMINI_API_KEY=your-gemini-key
# Optional: the Gemini model to ask first (others are tried when it is busy)
# GEMINI_MODEL=gemini-3.5-flash
